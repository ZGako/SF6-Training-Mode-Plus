<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SF6_TMP</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <Choose>
    <When Condition="Exists('..\libs')">
      <PropertyGroup>
        <LibsPath>..\libs</LibsPath>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <LibsPath></LibsPath>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup Condition=" '$(LibsPath)' != '' ">
    <Reference Include="REFramework.NET">
      <HintPath>$(LibsPath)\REFramework.NET.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET._mscorlib">
      <HintPath>$(LibsPath)\managed\generated\REFramework.NET._mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET._System.Core">
      <HintPath>$(LibsPath)\managed\generated\REFramework.NET._System.Core.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET._System">
      <HintPath>$(LibsPath)\managed\generated\REFramework.NET._System.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET.application">
      <HintPath>$(LibsPath)\managed\generated\REFramework.NET.application.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET.viacore">
      <HintPath>$(LibsPath)\managed\generated\REFramework.NET.viacore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\Core\SF6PluginCore.csproj')">
    <ProjectReference Include="..\Core\SF6PluginCore.csproj">
      <Private>False</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Condition=" '$(SF6Dir)' != '' " Name="BuildAndUpdateScript" AfterTargets="Build">

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SF6Dir)\reframework\plugins\managed\" />

  </Target>

</Project>
